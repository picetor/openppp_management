OPENPPP2_LISTEN=0.0.0.0:8080
OPENPPP2_BIND_ADDRESS=127.0.0.1:8080
OPENPPP2_PUBLIC_URL=https://manager.example.com
OPENPPP2_ADMIN_USERNAME=admin
OPENPPP2_ADMIN_PASSWORD=change-this-password
OPENPPP2_COMMUNICATION_KEY=change-this-node-communication-key

# mysql or sqlite
OPENPPP2_DATABASE_DRIVER=mysql
OPENPPP2_DATABASE_DSN=openppp2:change-this-password@tcp(mysql:3306)/openppp2_management?charset=utf8mb4&parseTime=true&loc=UTC
# OPENPPP2_DATABASE_PATH=/app/data/management.db

OPENPPP2_SESSION_TTL_HOURS=168
OPENPPP2_NODE_OFFLINE_SECONDS=90
